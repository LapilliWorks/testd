#!/bin/sh
# testd-hosts-helper: manages a block in /etc/hosts for testd domains.
#
# Intended to run via sudo with a NOPASSWD sudoers rule. Validates all
# input strictly so it's safe to grant passwordless execution.
#
# Usage: sudo testd-hosts-helper --tld <tld> [--hosts-path /etc/hosts]
# Stdin: one JSON-quoted domain per line (NDJSON), e.g. "myapp.test"
#        Empty stdin = cleanup (only the built-in testd.<tld> entry remains).
#
# Install: testd setup-hosts-helper

set -eu

START_MARKER='# testd-start'
END_MARKER='# testd-end'

die() {
	echo "testd-hosts-helper: $1" >&2
	exit 1
}

# -- Parse arguments ----------------------------------------------------------

TLD=""
HOSTS_PATH="/etc/hosts"

while [ $# -gt 0 ]; do
	case "$1" in
		--tld)
			[ $# -ge 2 ] || die "missing value for --tld"
			TLD="$2"; shift 2 ;;
		--hosts-path)
			[ $# -ge 2 ] || die "missing value for --hosts-path"
			HOSTS_PATH="$2"; shift 2 ;;
		*)
			die "unknown argument: $1" ;;
	esac
done

# -- Validate arguments --------------------------------------------------------

[ -n "$TLD" ] || die "--tld is required"

# TLD: lowercase alphanumeric, 1-10 chars.
echo "$TLD" | grep -qxE '[a-z0-9]{1,10}' || die "invalid tld: $TLD"

# Hosts path: must be an existing regular file.
[ -f "$HOSTS_PATH" ] || die "hosts file not found: $HOSTS_PATH"

# -- Read and validate domains from stdin --------------------------------------

DOMAINS=""
while IFS= read -r line || [ -n "$line" ]; do
	# Skip empty lines.
	[ -n "$line" ] || continue

	# Strip JSON quotes: "domain.tld" -> domain.tld
	domain=$(echo "$line" | sed 's/^"//;s/"$//')
	[ -n "$domain" ] || continue

	# Length check (DNS max 253).
	len=$(printf '%s' "$domain" | wc -c)
	[ "$len" -le 253 ] || die "domain too long: $domain"

	# Character set: lowercase alphanumeric, dots, hyphens.
	echo "$domain" | grep -qxE '[a-z0-9][a-z0-9.-]*[a-z0-9]' || die "invalid domain: $domain"

	# No consecutive dots.
	echo "$domain" | grep -qF '..' && die "invalid domain (consecutive dots): $domain"

	# Must end with .<tld>.
	case "$domain" in
		*."$TLD") ;;
		*) die "domain does not end with .$TLD: $domain" ;;
	esac

	DOMAINS="${DOMAINS}127.0.0.1 ${domain}
"
done

# -- Build managed block -------------------------------------------------------

BLOCK="${START_MARKER}
127.0.0.1 testd.${TLD}
${DOMAINS}${END_MARKER}"

# -- Write to hosts file -------------------------------------------------------

CONTENT=$(cat "$HOSTS_PATH" 2>/dev/null || true)

if echo "$CONTENT" | grep -qF "$START_MARKER" && echo "$CONTENT" | grep -qF "$END_MARKER"; then
	# Replace existing block. Use awk for multi-line replacement.
	NEW_CONTENT=$(echo "$CONTENT" | awk -v block="$BLOCK" -v sm="$START_MARKER" -v em="$END_MARKER" '
		BEGIN { inside = 0 }
		index($0, sm) == 1 { inside = 1; print block; next }
		inside && index($0, em) == 1 { inside = 0; next }
		!inside { print }
	')
else
	# Append block.
	if [ -z "$CONTENT" ]; then
		NEW_CONTENT="$BLOCK"
	elif printf '%s' "$CONTENT" | tail -c 1 | grep -qx ''; then
		# Content ends with newline.
		NEW_CONTENT="${CONTENT}${BLOCK}"
	else
		NEW_CONTENT="${CONTENT}
${BLOCK}"
	fi
fi

printf '%s\n' "$NEW_CONTENT" > "$HOSTS_PATH"
