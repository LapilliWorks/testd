{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Testd",
	"version": "0.1.0-alpha",
	"identifier": "dev.testd.host",
	"build": {
		"frontendDist": "../frontend"
	},
	"app": {
		"windows": [],
		"withGlobalTauri": true
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["testd"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"../packaging/macos/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
		},
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
