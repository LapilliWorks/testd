require 'json'

class Testd < Formula
  desc "Local dev domain manager: stable HTTPS names from any dev environment"
  homepage "https://github.com/LapilliWorks/testd"
  version '@VERSION@'
  url 'https://github.com/LapilliWorks/testd/archive/refs/tags/v@VERSION@.tar.gz'
  sha256 '@SOURCE_SHA256@'
  license "ISC"
  head "https://github.com/LapilliWorks/testd.git", branch: "master"

  depends_on "rust" => :build

  def install
    system "cargo", "install", *std_cargo_args(path: ".")
  end

  service do
    run [opt_bin/"testd", "host"]
    keep_alive true
    log_path var/"log/testd.log"
    error_log_path var/"log/testd.err"
  end

  test do
    ENV['HOME'] = testpath.to_s
    assert_match "testd", shell_output("#{bin}/testd --help")
    assert_match 'testd @VERSION@', shell_output("#{bin}/testd --version")
    summary = JSON.parse(shell_output("#{bin}/testd doctor --json", 1))
    assert_equal 1, summary.fetch('exit_code')
  end
end
