{
	"name": "testd-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "sh sites/bin/site.sh dev",
		"build": "bun run build:product && bun run build:docs",
		"build:product": "vite build sites/product",
		"build:docs": "vitepress build sites/docs",
		"preview": "vite preview sites/product",
		"check": "tsc -p . && tsc -p sites/product && tsc -p sites/docs",
		"check:links": "bun scripts/check-links.ts"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0"
	},
	"devDependencies": {
		"@types/node": "^24",
		"typescript": "^5.9.3",
		"vite": "^5.4.14",
		"vitepress": "^1.6.4"
	}
}
